# Prumysl — clean URLs (hide index.html in the address bar)
# Works on Apache / most cPanel hosts. Publish this file at the site root.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Guard Corps hidden for now — redirect to homepage
RewriteRule ^guard-corps(/.*)?$ / [R=302,L,NE]

# /index.html → /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

# /moka/index.html → /moka/
RewriteCond %{THE_REQUEST} \s/+(.+/)index\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Serve index.html for pretty paths (/moka/, /moka, /thank-you/…)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
